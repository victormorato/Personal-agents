# Postgres connection string (Render provides this automatically for a
# managed Postgres instance attached to the web service)
DATABASE_URL=postgresql://user:password@host:5432/personal_agents

# Anthropic API key used by the CEO and division agents
ANTHROPIC_API_KEY=

# Single static bearer token the Android app authenticates with.
# This app is single-user by design (see DESIGN.md) — this is not a full
# auth system, just a shared secret between the one app instance and the backend.
API_AUTH_TOKEN=

# Google Fit OAuth (exercise division data sync)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# Firebase Cloud Messaging server key (CEO push notifications)
FCM_SERVER_KEY=
